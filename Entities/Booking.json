{
  "name": "Booking",
  "type": "object",
  "properties": {
    "service_id": {
      "type": "string",
      "description": "ID des gebuchten Services"
    },
    "service_name": {
      "type": "string",
      "description": "Name des Services"
    },
    "booking_date": {
      "type": "string",
      "format": "date",
      "description": "Gew\u00fcnschtes Datum"
    },
    "booking_time": {
      "type": "string",
      "description": "Gew\u00fcnschte Uhrzeit"
    },
    "customer_name": {
      "type": "string",
      "description": "Name des Kunden"
    },
    "customer_email": {
      "type": "string",
      "description": "E-Mail des Kunden"
    },
    "customer_phone": {
      "type": "string",
      "description": "Telefonnummer"
    },
    "address": {
      "type": "string",
      "description": "Adresse f\u00fcr den Service"
    },
    "notes": {
      "type": "string",
      "description": "Zus\u00e4tzliche W\u00fcnsche"
    },
    "status": {
      "type": "string",
      "enum": [
        "ausstehend",
        "best\u00e4tigt",
        "in_bearbeitung",
        "abgeschlossen",
        "storniert"
      ],
      "default": "ausstehend"
    },
    "total_price": {
      "type": "number",
      "description": "Gesamtpreis"
    }
  },
  "required": [
    "service_id",
    "service_name",
    "booking_date",
    "customer_name",
    "customer_email",
    "total_price"
  ]
}