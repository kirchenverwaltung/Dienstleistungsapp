{
  "name": "Application",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "ID des Jobs"
    },
    "job_title": {
      "type": "string",
      "description": "Titel des Jobs"
    },
    "job_date": {
      "type": "string",
      "format": "date",
      "description": "Datum des Jobs"
    },
    "applicant_name": {
      "type": "string",
      "description": "Name des Bewerbers"
    },
    "applicant_email": {
      "type": "string",
      "description": "E-Mail des Bewerbers"
    },
    "applicant_phone": {
      "type": "string",
      "description": "Telefon des Bewerbers"
    },
    "message": {
      "type": "string",
      "description": "Nachricht an Arbeitgeber"
    },
    "experience": {
      "type": "string",
      "description": "Relevante Erfahrung"
    },
    "status": {
      "type": "string",
      "enum": [
        "ausstehend",
        "angenommen",
        "abgelehnt",
        "zur\u00fcckgezogen"
      ],
      "default": "ausstehend"
    },
    "employer_email": {
      "type": "string",
      "description": "E-Mail des Arbeitgebers"
    }
  },
  "required": [
    "job_id",
    "job_title",
    "applicant_name",
    "applicant_email"
  ]
}